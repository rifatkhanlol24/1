rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // STRICT SINGLE AUTHORITATIVE ADMIN CHECK
    // Only the specified UID is authorized as platform administrator
    function isAdmin() {
      return isSignedIn() && request.auth.uid == "UI28ofvzB7cjNJvCG0DvYgbCu9J3";
    }

    function isModerator() {
      return isAdmin(); // Tied to authoritative admin
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only written via Firebase Console / Backend
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isSignedIn() || request.auth.uid == userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin());
      allow update: if (isOwner(userId) || isAdmin() || isModerator()) &&
        // Regular users cannot escalate their role or tamper with security fields
        (isAdmin() || !('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Default fallback - All other root paths and sensitive collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
